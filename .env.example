# Notaformat 환경변수 예시
# 이 파일을 .env 로 복사해서 값을 채웁니다.
# (아래 키 이름은 server 코드가 실제로 읽는 것과 일치시켰습니다)

# ── 필수 ──────────────────────────────────────────────────────────────────
# Gemini API 키 — 이미지 분석·HTML 복원에 사용
GEMINI_API_KEY=""

# JWT 서명 키 — 배포 시 반드시 임의의 긴 문자열로 바꾸세요
JWT_SECRET_KEY=""

# ── 선택: 데이터베이스 ────────────────────────────────────────────────────
# 비우면 SQLite(server/notaformat.db)로 동작합니다.
# 컨테이너는 재시작 시 초기화되므로, 계정·이력을 유지하려면
# 외부 DB 를 지정하거나 해당 경로에 볼륨을 붙이세요.
#   MySQL:      mysql+pymysql://user:pass@host:3306/dbname
#   PostgreSQL: postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=""

# ── 선택: 부가 기능 ───────────────────────────────────────────────────────
# OpenAI 를 함께 쓰는 경우에만 필요
OPENAI_API_KEY=""

# 비밀번호 찾기 메일 발송 (미설정 시 해당 기능만 동작하지 않음)
SMTP_EMAIL=""
SMTP_PASSWORD=""

# 휴대폰 인증 (미설정 시 해당 기능만 동작하지 않음)
COOLSMS_API_KEY=""
COOLSMS_API_SECRET=""
COOLSMS_SENDER=""

# ── 선택: 모델·토큰 튜닝 ─────────────────────────────────────────────────
# 비워 두면 아래 기본값을 씁니다. 모델을 올리고 싶으면 이 값만 바꾸면 되고
# 코드 수정은 필요 없습니다.
#
#   MODEL_CLASSIFY  영역 판정 (5개 라벨 중 선택)   기본 gpt-4o-mini
#   MODEL_GENERATE  mermaid·chart·수식 코드 생성   기본 gpt-4o
#   MODEL_VISION    이미지 구조 분석               기본 gpt-4o
#   MODEL_EXTRACT   페이지 → HTML 추출(Gemini)     기본 gemini-2.5-flash
MODEL_CLASSIFY=""
MODEL_GENERATE=""
MODEL_VISION=""
MODEL_EXTRACT=""

# 모델에 보낼 이미지의 긴 변 상한(px).
# 비전 토큰은 해상도에 비례하므로 비용에 가장 큰 영향을 줍니다.
# 손글씨 판독에는 1536 이면 충분합니다.
MAX_IMAGE_SIDE="1536"

# ── 선택: 실행 환경 ───────────────────────────────────────────────────────
# 호스팅 업체가 주입하는 포트. 없으면 8000 을 씁니다.
PORT="8000"
