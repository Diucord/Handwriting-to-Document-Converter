{
  "name": "notaformat",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "cd server && python -m uvicorn main:app --reload --host 0.0.0.0 --port 4000",
    "dev:client": "npm run dev --prefix client",
    "setup": "python -m pip install -r requirements.txt && npm install && npm install --prefix client"
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "markdown-pdf": "^11.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.11"
  }
}
